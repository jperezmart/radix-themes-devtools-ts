{
  "name": "ts-devtools-plugin-radix-themes",
  "version": "0.3.1",
  "description": "TanStack Devtools plugin for Radix UI Themes — customize your theme in real time from the devtools panel",
  "keywords": [
    "radix",
    "radix-ui",
    "radix-themes",
    "devtools",
    "tanstack",
    "tanstack-devtools",
    "theme",
    "react"
  ],
  "homepage": "https://github.com/jperezmart/radix-themes-devtools-ts#readme",
  "bugs": {
    "url": "https://github.com/jperezmart/radix-themes-devtools-ts/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jperezmart/radix-themes-devtools-ts.git",
    "directory": "packages/ts-devtools-plugin-radix-themes"
  },
  "license": "MIT",
  "sideEffects": false,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./provider": {
      "types": "./dist/provider.d.ts",
      "import": "./dist/provider.js",
      "require": "./dist/provider.cjs"
    },
    "./plugin": {
      "types": "./dist/plugin.d.ts",
      "import": "./dist/plugin.js",
      "require": "./dist/plugin.cjs"
    },
    "./plugin-noop": {
      "types": "./dist/plugin-noop.d.ts",
      "import": "./dist/plugin-noop.js",
      "require": "./dist/plugin-noop.cjs"
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "vite build",
    "dev": "vite build --watch",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@radix-ui/themes": "^3.3.0",
    "@tanstack/devtools-event-client": "^0.5.0",
    "@tanstack/devtools-utils": "^0.7.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "jsdom": "^30.1.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typescript": "^5.9.3",
    "vite": "^8.3.0",
    "vite-plugin-dts": "^5.1.1",
    "vitest": "^5.0.1"
  },
  "peerDependencies": {
    "@radix-ui/themes": ">=3.0.0",
    "@tanstack/devtools-event-client": ">=0.4.0",
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0"
  },
  "peerDependenciesMeta": {
    "@tanstack/devtools-event-client": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=20"
  }
}
